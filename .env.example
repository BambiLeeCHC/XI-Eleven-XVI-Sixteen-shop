# ─── Client (browser-safe) ────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ─── Server only — never prefix these with VITE_ ──────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=17855930
PRINTFUL_WEBHOOK_TOKEN=

# Stripe: the secret is read from whichever of these is set, base64 first.
STRIPE_KEY_ENCODED_V2=
STRIPE_SECRET_KEY=

# Optional — CRM email (Resend) and the Style Concierge.
RESEND_API_KEY=
VIKTOR_SPACES_API_URL=
VIKTOR_SPACES_PROJECT_NAME=
VIKTOR_SPACES_PROJECT_SECRET=

# Do NOT set CONVEX_DEPLOY_KEY, CONVEX_DEPLOYMENT, or VITE_CONVEX_URL.
# The store runs on Supabase + Vercel serverless (api/). There is no convex/ directory.
